[Unit]
Description=Email Validation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=saas
WorkingDirectory=/opt/saas
EnvironmentFile=/opt/saas/.env
Environment=PYTHONUNBUFFERED=1
Environment=SAAS_DB=/opt/saas/data/mailcheck.db
ExecStart=/opt/saas/venv/bin/python serve.py mailcheck --port 8005
Restart=always
RestartSec=10
SyslogIdentifier=saas-mailcheck

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/saas/data
MemoryMax=384M

[Install]
WantedBy=multi-user.target
