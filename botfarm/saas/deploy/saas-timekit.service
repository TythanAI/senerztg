[Unit]
Description=Time Toolkit API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=saas
WorkingDirectory=/opt/saas
EnvironmentFile=/opt/saas/.env
Environment=PYTHONUNBUFFERED=1
Environment=SAAS_DB=/opt/saas/data/timekit.db
ExecStart=/opt/saas/venv/bin/python serve.py timekit --port 8013
Restart=always
RestartSec=10
SyslogIdentifier=saas-timekit

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/saas/data
MemoryMax=384M

[Install]
WantedBy=multi-user.target
