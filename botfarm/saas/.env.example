# API rack configuration. Copy to .env and fill in.

# Required: guards POST /admin/keys on every service.
# Generate with: openssl rand -hex 24
SAAS_ADMIN_TOKEN=

# Public HTTPS base, used for Stripe return URLs and short links.
PUBLIC_BASE_URL=https://api.example.com

# --- Card payments (Stripe) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Crypto payments (@CryptoBot) -------------------------------------------
CRYPTOBOT_TOKEN=

LOG_LEVEL=info
