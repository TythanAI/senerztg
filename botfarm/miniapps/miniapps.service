[Unit]
Description=Telegram Mini Apps server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botfarm
WorkingDirectory=/opt/botfarm/botfarm/miniapps
EnvironmentFile=/opt/botfarm/botfarm/miniapps/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/botfarm/venv/bin/python serve.py
Restart=always
RestartSec=10
SyslogIdentifier=miniapps

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/botfarm/botfarm/miniapps/data
MemoryMax=384M

[Install]
WantedBy=multi-user.target
