[Unit]
Description=BTC Цикл (ru-023-btc-cycle)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botfarm
WorkingDirectory=/opt/botfarm/bots/ru/023-btc-cycle
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/botfarm/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=botfarm-ru-btc-cycle

# Hardening — the bot only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/botfarm/bots/ru/023-btc-cycle
MemoryMax=384M

[Install]
WantedBy=multi-user.target
