[Unit]
Description=Audible Подписки (ru-270-audible)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botfarm
WorkingDirectory=/opt/botfarm/bots/ru/270-audible
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/botfarm/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=botfarm-ru-270-audible

# Hardening — the bot only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/botfarm/bots/ru/270-audible
MemoryMax=384M

[Install]
WantedBy=multi-user.target
