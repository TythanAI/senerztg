# Йога Каждый День (ru-058-yoga-daily)
# Copy to .env and fill in. Never commit .env.

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=
# Your Telegram user id(s), comma separated. Get it from @userinfobot.
ADMIN_IDS=

# --- Storage ----------------------------------------------------------------
# SQLite is fine up to a few thousand users. For more, point at Postgres:
# DB_URL=postgresql+asyncpg://user:password@localhost/yoga_daily
DB_URL=sqlite+aiosqlite:///bot.db

# --- YooKassa (cards + SBP, RU) ---------------------------------------------
# From https://yookassa.ru/my → Settings → Shop
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Crypto Pay (@CryptoBot) ------------------------------------------------
# Open @CryptoBot → Crypto Pay → Create App
CRYPTOBOT_TOKEN=

# --- Web side-car (health checks, payment webhooks) -------------------------
WEB_HOST=0.0.0.0
WEB_PORT=9057
# Public HTTPS base for this bot, e.g. https://pay.example.com/ru-058-yoga-daily
WEBHOOK_BASE=
# Random string; protects /metrics. Generate: openssl rand -hex 16
WEBHOOK_SECRET=

LOG_LEVEL=INFO
