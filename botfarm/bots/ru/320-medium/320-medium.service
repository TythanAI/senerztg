[Unit]
Description=Medium Аккаунты (ru-320-medium)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botfarm
WorkingDirectory=/opt/botfarm/bots/ru/320-medium
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/botfarm/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=botfarm-ru-320-medium

# Hardening — the bot only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/botfarm/bots/ru/320-medium
MemoryMax=384M

[Install]
WantedBy=multi-user.target
