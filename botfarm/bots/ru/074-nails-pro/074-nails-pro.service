[Unit]
Description=Ногтевой Сервис (ru-074-nails-pro)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botfarm
WorkingDirectory=/opt/botfarm/bots/ru/074-nails-pro
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/botfarm/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=botfarm-ru-nails-pro

# Hardening — the bot only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/botfarm/bots/ru/074-nails-pro
MemoryMax=384M

[Install]
WantedBy=multi-user.target
