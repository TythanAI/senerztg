# Tarkov Boosting (eu-451-tarkov-boost-eu)
# Copy to .env and fill in. Never commit .env.

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=
# Your Telegram user id(s), comma separated. Get it from @userinfobot.
ADMIN_IDS=

# --- Storage ----------------------------------------------------------------
# SQLite is fine up to a few thousand users. For more, point at Postgres:
# DB_URL=postgresql+asyncpg://user:password@localhost/tarkov_boost_eu
DB_URL=sqlite+aiosqlite:///bot.db

# --- Stripe (cards, Apple/Google Pay, EU/US) --------------------------------
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From the webhook endpoint you create for /eu-451-tarkov-boost-eu/webhook/stripe
STRIPE_WEBHOOK_SECRET=

# --- Crypto Pay (@CryptoBot) ------------------------------------------------
# Open @CryptoBot → Crypto Pay → Create App
CRYPTOBOT_TOKEN=

# --- Web side-car (health checks, payment webhooks) -------------------------
WEB_HOST=0.0.0.0
WEB_PORT=9950
# Public HTTPS base for this bot, e.g. https://pay.example.com/eu-451-tarkov-boost-eu
WEBHOOK_BASE=
# Random string; protects /metrics. Generate: openssl rand -hex 16
WEBHOOK_SECRET=

LOG_LEVEL=INFO
